# Google OAuth — get your client ID from https://console.cloud.google.com
VITE_GOOGLE_CLIENT_ID=your_google_client_id_here

# Backend API URL — only needed in production
# Leave empty in development (Vite proxy handles it)
# Example: https://quickie-server.onrender.com
VITE_API_URL=https://quickie-one.vercel.app/
